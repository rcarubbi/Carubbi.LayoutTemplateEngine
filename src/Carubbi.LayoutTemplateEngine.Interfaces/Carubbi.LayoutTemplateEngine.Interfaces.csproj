<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Carubbi.LayoutTemplateEngine.Interfaces</RootNamespace>
    <AssemblyName>Carubbi.LayoutTemplateEngine.Interfaces</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Carubbi.LayoutTemplateEngine.Interfaces</PackageId>
    <Version>2.1.0</Version>
    <Authors>Raphael Carubbi Neto</Authors>
    <Description>Interfaces for the Carubbi layout template engine wrappers</Description>
    <PackageTags>Template Engine Razor NVelocity Layout</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/rcarubbi/Carubbi.LayoutTemplateEngine.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
